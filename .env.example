# Copy this file to ".env" and fill in your own values. Never commit the real .env file.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string. Keep "/srms" (the database name) before the "?".
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/srms?appName=<appname>

# Any long random string. It signs the login tokens.
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# The frontend address allowed to call this API (no trailing slash).
CLIENT_ORIGIN=http://localhost:5173
